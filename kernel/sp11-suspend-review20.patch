From 7508864c46fa6940048923437613cfa762beaf95 Mon Sep 17 00:00:00 2001
From: Mukesh Ojha <mukesh.ojha@oss.qualcomm.com>
Date: Wed, 27 May 2026 15:24:26 +0530
Subject: [PATCH 04/20] irqchip/qcom-pdc: Use FIELD_GET() to extract bank index
 and bit position

The IRQ_ENABLE_BANK register is a bank of 32-bit words where each bit
represents one PDC pin. The bank index and bit position within the bank
are encoded in the flat pin number as bits [31:5] and [4:0] respectively.

Replace the open-coded division and modulo with FIELD_GET() and GENMASK()
to make the bit extraction self-documenting and consistent with the
FIELD_PREP() style already used in the PDC_VERSION() macro.

Reviewed-by: Konrad Dybcio <konrad.dybcio@oss.qualcomm.com>
Signed-off-by: Mukesh Ojha <mukesh.ojha@oss.qualcomm.com>
---
 drivers/irqchip/qcom-pdc.c | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/drivers/irqchip/qcom-pdc.c b/drivers/irqchip/qcom-pdc.c
index 9ad2c22342e105f761279c43c3277f0717350051..17ca26d66fea2069e871da6e417ff35cb4b83395 100644
--- a/drivers/irqchip/qcom-pdc.c
+++ b/drivers/irqchip/qcom-pdc.c
@@ -27,6 +27,8 @@
 /* Valid only on HW version < 3.2 */
 #define IRQ_ENABLE_BANK		0x10
 #define IRQ_ENABLE_BANK_MAX	(IRQ_ENABLE_BANK + BITS_TO_BYTES(PDC_MAX_GPIO_IRQS))
+#define IRQ_ENABLE_BANK_INDEX_MASK	GENMASK(31, 5)
+#define IRQ_ENABLE_BANK_BIT_MASK	GENMASK(4, 0)
 #define IRQ_i_CFG		0x110
 
 /* Valid only on HW version >= 3.2 */
@@ -110,8 +112,8 @@ static void pdc_enable_intr_bank(int pin_out, bool on)
 	unsigned long enable;
 	u32 index, mask;
 
-	index = pin_out / 32;
-	mask = pin_out % 32;
+	index = FIELD_GET(IRQ_ENABLE_BANK_INDEX_MASK, pin_out);
+	mask = FIELD_GET(IRQ_ENABLE_BANK_BIT_MASK, pin_out);
 
 	enable = pdc_reg_read(IRQ_ENABLE_BANK, index);
 	__assign_bit(mask, &enable, on);
-- 
2.55.0


From b876b811169545107a697ce73dc8faaf822fa479 Mon Sep 17 00:00:00 2001
From: turbinebmw <turbine.bmw@gmail.com>
Date: Sat, 25 Jul 2026 20:12:30 -0400
Subject: [PATCH 05/20] cpuidle: psci: make the Surface Pro 11 deep-idle block
 opt-out

The Denali quirk added with the platform disables every firmware-managed
PSCI state unconditionally, because entering the retention state while a
display or RPMh resource transition is in flight can wedge the fabric
hard enough that all twelve CPUs lose interrupts.

That mitigation is load bearing and stays the default. But it is also
expensive, and there is currently no way to measure what it costs or to
retest it after a suspected fix without rebuilding the kernel. The state
cannot be re-enabled from userspace either: writing the sysfs disable
attribute clears only the user bit, while this sets the driver bit.

Add sp11_deep_idle to opt back in at boot. The default is unchanged, the
opt-in path warns loudly, and one kernel can now be booted both ways.

This is a local debugging aid, not an upstream candidate.

Signed-off-by: turbinebmw <turbine.bmw@gmail.com>
---
 .../admin-guide/kernel-parameters.txt         |  8 +++++++
 drivers/cpuidle/cpuidle-psci.c                | 23 ++++++++++++++++++-
 2 files changed, 30 insertions(+), 1 deletion(-)

diff --git a/Documentation/admin-guide/kernel-parameters.txt b/Documentation/admin-guide/kernel-parameters.txt
index 97007f4f69d4e8f19acaff81c9af8421a09822bf..a6ddb05b2664c54f5a6eb1e78286e2de104cd5d9 100644
--- a/Documentation/admin-guide/kernel-parameters.txt
+++ b/Documentation/admin-guide/kernel-parameters.txt
@@ -7059,6 +7059,14 @@ Kernel parameters
 	sonypi.*=	[HW] Sony Programmable I/O Control Device driver
 			See Documentation/admin-guide/laptops/sonypi.rst
 
+	sp11_deep_idle	[ARM64] Re-enable the firmware-managed PSCI idle
+			states on the Microsoft Surface Pro 11, which are
+			disabled by default because entering them while a
+			display or RPMh resource transition is in flight can
+			wedge the interconnect and hard-lock the machine.
+			Intended for measuring the cost of that mitigation
+			and for retesting it.  Expect lockups.
+
 	spectre_bhi=	[X86] Control mitigation of Branch History Injection
 			(BHI) vulnerability.  This setting affects the
 			deployment of the HW BHI control and the SW BHB
diff --git a/drivers/cpuidle/cpuidle-psci.c b/drivers/cpuidle/cpuidle-psci.c
index b38ca2e11c74dac65e3fd08d8c73b2bdb47d3b0d..26addd90a70bba97d018719016ef36d2f3e3697f 100644
--- a/drivers/cpuidle/cpuidle-psci.c
+++ b/drivers/cpuidle/cpuidle-psci.c
@@ -45,6 +45,21 @@ struct psci_cpuidle_domain_state {
 static DEFINE_PER_CPU_READ_MOSTLY(struct psci_cpuidle_data, psci_cpuidle_data);
 static DEFINE_PER_CPU(struct psci_cpuidle_domain_state, psci_domain_state);
 static bool psci_cpuidle_use_syscore;
+static bool sp11_deep_idle;
+
+static int __init sp11_deep_idle_setup(char *str)
+{
+	/*
+	 * __setup() hands us everything after the matched name, so this sees
+	 * "=1" for sp11_deep_idle=1 and "" for a bare sp11_deep_idle.
+	 */
+	if (*str == '=')
+		str++;
+
+	sp11_deep_idle = !*str || !strcmp(str, "1") || !strcmp(str, "on");
+	return 1;
+}
+__setup("sp11_deep_idle", sp11_deep_idle_setup);
 
 void psci_set_domain_state(struct generic_pm_domain *pd, unsigned int state_idx,
 			   u32 state)
@@ -415,12 +430,18 @@ static int psci_idle_init_cpu(struct device *dev, int cpu)
 	 * races a display/RPMh resource transition.  Keep the CPUIdle framework
 	 * and architectural WFI state, but default every firmware-managed state
 	 * to off before this per-CPU driver is registered.
+	 *
+	 * sp11_deep_idle=1 opts back in, for measuring what the mitigation costs
+	 * and for testing whether a fix has landed.  It is expected to be able to
+	 * hard-lock the machine, so it is opt-in and off by default.
 	 */
-	if (of_machine_is_compatible("microsoft,denali")) {
+	if (of_machine_is_compatible("microsoft,denali") && !sp11_deep_idle) {
 		for (i = 1; i < drv->state_count; i++)
 			drv->states[i].flags |= CPUIDLE_FLAG_OFF;
 
 		pr_info_once("Surface Pro 11: PSCI non-WFI states disabled by default\n");
+	} else if (of_machine_is_compatible("microsoft,denali")) {
+		pr_warn_once("Surface Pro 11: PSCI non-WFI states ENABLED by sp11_deep_idle - this can hard-lock the machine\n");
 	}
 
 	ret = cpuidle_register(drv, NULL);
-- 
