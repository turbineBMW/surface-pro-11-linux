From b7ea57b19e1a2b3a04ebe4866172c403d92afc31 Mon Sep 17 00:00:00 2001
From: turbinebmw <turbine.bmw@gmail.com>
Date: Sun, 26 Jul 2026 08:21:43 -0400
Subject: [PATCH 17/20] soc: qcom: smp2p: reset inbound state only on restart

SMP2P v2 needs cached inbound values reset when an SSR is detected because the remote no longer waits for the acknowledgement before setting its state. The current code performs that reset for every inbound notification instead.

With persistent ready and handover bits, unrelated ADSP notifications are therefore reported as fresh rising edges. This repeatedly invokes the q6v5 handlers and can keep the AP awake.

Return early when the restart flag has not changed so the cached values are preserved for ordinary notifications.

Fixes: 42c4cf5d4828 ("soc: qcom: smp2p: Add support for smp2p v2")
---
 drivers/soc/qcom/smp2p.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/qcom/smp2p.c b/drivers/soc/qcom/smp2p.c
index af0ceeaf6e07301accb07ee21a4d83f42a037d4e..89e242f4d0ca6fc163294957d16f5bea68674db9 100644
--- a/drivers/soc/qcom/smp2p.c
+++ b/drivers/soc/qcom/smp2p.c
@@ -194,13 +194,16 @@ static bool qcom_smp2p_check_ssr(struct qcom_smp2p *smp2p)
 
 	restart_done = in->flags & BIT(SMP2P_FLAGS_RESTART_DONE_BIT);
 	restart = restart_done != smp2p->ssr_ack;
+	if (!restart)
+		return false;
+
 	list_for_each_entry(entry, &smp2p->inbound, node) {
 		if (!entry->value)
 			continue;
 		entry->last_value = 0;
 	}
 
-	return restart;
+	return true;
 }
 
 static void qcom_smp2p_do_ssr_ack(struct qcom_smp2p *smp2p)
-- 
2.55.0


