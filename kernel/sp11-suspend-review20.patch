From 81d01fe5d5bea23a8e1490f537986a87756df38d Mon Sep 17 00:00:00 2001
From: turbinebmw <turbine.bmw@gmail.com>
Date: Sun, 26 Jul 2026 06:36:17 -0400
Subject: [PATCH 13/20] cpuidle: allow Denali PSCI states only in s2idle

The Surface Pro 11 can hard-lock when a PSCI idle state races a display or RPMh transition, so the local Denali quirk disables every firmware-managed state at runtime. Globally removing that block reproduces the wedge during early suspend entry, before device suspend has made deep idle safe.

Add an experimental sp11_s2idle_deep option that preserves the runtime block and permits marked states only from the final suspend-to-idle loop. This keeps suspend entry and resume on WFI while allowing the already-suspended system to select PSCI domain states.

This is a local diagnostic candidate, not an upstream interface.
---
 .../admin-guide/kernel-parameters.txt         |  9 +++++
 drivers/cpuidle/cpuidle-psci.c                | 40 +++++++++++++++----
 drivers/cpuidle/cpuidle.c                     |  3 +-
 include/linux/cpuidle.h                       |  1 +
 4 files changed, 44 insertions(+), 9 deletions(-)

diff --git a/Documentation/admin-guide/kernel-parameters.txt b/Documentation/admin-guide/kernel-parameters.txt
index a6ddb05b2664c54f5a6eb1e78286e2de104cd5d9..a98ba2a3f92bc4f689c7f44b5cfc9366e61cba1c 100644
--- a/Documentation/admin-guide/kernel-parameters.txt
+++ b/Documentation/admin-guide/kernel-parameters.txt
@@ -7067,6 +7067,15 @@ Kernel parameters
 			Intended for measuring the cost of that mitigation
 			and for retesting it.  Expect lockups.
 
+	sp11_s2idle_deep
+			[ARM64] Re-enable the firmware-managed PSCI idle
+			states on the Microsoft Surface Pro 11 only after
+			device suspend, inside the final suspend-to-idle
+			loop. Runtime idle and the suspend entry/resume paths
+			remain limited to WFI. Intended for controlled testing
+			of low-power s2idle without reopening the known display
+			transition race. This is experimental.
+
 	spectre_bhi=	[X86] Control mitigation of Branch History Injection
 			(BHI) vulnerability.  This setting affects the
 			deployment of the HW BHI control and the SW BHB
diff --git a/drivers/cpuidle/cpuidle-psci.c b/drivers/cpuidle/cpuidle-psci.c
index 26addd90a70bba97d018719016ef36d2f3e3697f..876622fe29b6a7edbde2e5fbea476e63e78f74e4 100644
--- a/drivers/cpuidle/cpuidle-psci.c
+++ b/drivers/cpuidle/cpuidle-psci.c
@@ -46,21 +46,34 @@ static DEFINE_PER_CPU_READ_MOSTLY(struct psci_cpuidle_data, psci_cpuidle_data);
 static DEFINE_PER_CPU(struct psci_cpuidle_domain_state, psci_domain_state);
 static bool psci_cpuidle_use_syscore;
 static bool sp11_deep_idle;
+static bool sp11_s2idle_deep;
 
-static int __init sp11_deep_idle_setup(char *str)
+static bool __init sp11_idle_param_enabled(char *str)
 {
 	/*
 	 * __setup() hands us everything after the matched name, so this sees
-	 * "=1" for sp11_deep_idle=1 and "" for a bare sp11_deep_idle.
+	 * "=1" for name=1 and "" for a bare name.
 	 */
 	if (*str == '=')
 		str++;
 
-	sp11_deep_idle = !*str || !strcmp(str, "1") || !strcmp(str, "on");
+	return !*str || !strcmp(str, "1") || !strcmp(str, "on");
+}
+
+static int __init sp11_deep_idle_setup(char *str)
+{
+	sp11_deep_idle = sp11_idle_param_enabled(str);
 	return 1;
 }
 __setup("sp11_deep_idle", sp11_deep_idle_setup);
 
+static int __init sp11_s2idle_deep_setup(char *str)
+{
+	sp11_s2idle_deep = sp11_idle_param_enabled(str);
+	return 1;
+}
+__setup("sp11_s2idle_deep", sp11_s2idle_deep_setup);
+
 void psci_set_domain_state(struct generic_pm_domain *pd, unsigned int state_idx,
 			   u32 state)
 {
@@ -431,15 +444,26 @@ static int psci_idle_init_cpu(struct device *dev, int cpu)
 	 * and architectural WFI state, but default every firmware-managed state
 	 * to off before this per-CPU driver is registered.
 	 *
-	 * sp11_deep_idle=1 opts back in, for measuring what the mitigation costs
-	 * and for testing whether a fix has landed.  It is expected to be able to
-	 * hard-lock the machine, so it is opt-in and off by default.
+	 * sp11_deep_idle=1 opts back in globally, for measuring what the
+	 * mitigation costs and for testing whether a fix has landed.  It is
+	 * expected to be able to hard-lock the machine.
+	 *
+	 * sp11_s2idle_deep=1 is narrower: runtime idle remains disabled during
+	 * the vulnerable suspend-entry and resume paths, but cpuidle may select
+	 * these states after device suspend, inside the final s2idle loop.
 	 */
 	if (of_machine_is_compatible("microsoft,denali") && !sp11_deep_idle) {
-		for (i = 1; i < drv->state_count; i++)
+		for (i = 1; i < drv->state_count; i++) {
 			drv->states[i].flags |= CPUIDLE_FLAG_OFF;
 
-		pr_info_once("Surface Pro 11: PSCI non-WFI states disabled by default\n");
+			if (sp11_s2idle_deep)
+				drv->states[i].flags |= CPUIDLE_FLAG_S2IDLE_ONLY;
+		}
+
+		if (sp11_s2idle_deep)
+			pr_warn_once("Surface Pro 11: PSCI non-WFI states enabled for s2idle only - experimental\n");
+		else
+			pr_info_once("Surface Pro 11: PSCI non-WFI states disabled by default\n");
 	} else if (of_machine_is_compatible("microsoft,denali")) {
 		pr_warn_once("Surface Pro 11: PSCI non-WFI states ENABLED by sp11_deep_idle - this can hard-lock the machine\n");
 	}
diff --git a/drivers/cpuidle/cpuidle.c b/drivers/cpuidle/cpuidle.c
index 2d2f40a2cb813c68bf355906f7aa3dc69984a8d0..511552b7ac7b61d47a7ccd09949f8c9dd4fb5953 100644
--- a/drivers/cpuidle/cpuidle.c
+++ b/drivers/cpuidle/cpuidle.c
@@ -93,7 +93,8 @@ static int find_deepest_state(struct cpuidle_driver *drv,
 	for (i = 1; i < drv->state_count; i++) {
 		struct cpuidle_state *s = &drv->states[i];
 
-		if (dev->states_usage[i].disable ||
+		if ((dev->states_usage[i].disable &&
+		     !(s2idle && (s->flags & CPUIDLE_FLAG_S2IDLE_ONLY))) ||
 		    s->exit_latency_ns <= latency_req ||
 		    s->exit_latency_ns > max_latency_ns ||
 		    (s->flags & forbidden_flags) ||
diff --git a/include/linux/cpuidle.h b/include/linux/cpuidle.h
index a2485348def3232b34f2d5037486062dd87757ea..1819b46158bbd2766fc3e1dfc65f2eb0ae30006d 100644
--- a/include/linux/cpuidle.h
+++ b/include/linux/cpuidle.h
@@ -85,6 +85,7 @@ struct cpuidle_state {
 #define CPUIDLE_FLAG_OFF		BIT(4) /* disable this state by default */
 #define CPUIDLE_FLAG_TLB_FLUSHED	BIT(5) /* idle-state flushes TLBs */
 #define CPUIDLE_FLAG_RCU_IDLE		BIT(6) /* idle-state takes care of RCU */
+#define CPUIDLE_FLAG_S2IDLE_ONLY	BIT(7) /* allow disabled state in s2idle */
 
 struct cpuidle_device_kobj;
 struct cpuidle_state_kobj;
