+	for (i = 0; i < ARRAY_SIZE(vd55g0_supply_name); i++)
+		sensor->supplies[i].supply = vd55g0_supply_name[i];
+
+	return devm_regulator_bulk_get(&sensor->i2c_client->dev,
+				       ARRAY_SIZE(vd55g0_supply_name),
+				       sensor->supplies);
+}
